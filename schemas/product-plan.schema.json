{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplatform.local/schemas/product-plan/1.0",
  "$ref": "#/$defs/plan",
  "$defs": {
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "deliverable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "acceptanceCriterionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          }
        },
        "dependsOn": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          }
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "deliverable",
        "acceptanceCriterionIds",
        "dependsOn"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "goalRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "goalHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "workItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/workItem"
          }
        }
      },
      "required": [
        "schemaVersion",
        "productId",
        "goalRevision",
        "goalHash",
        "summary",
        "workItems"
      ]
    },
    "saved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "productId",
        "revision",
        "hash",
        "plan",
        "createdAt",
        "confirmedAt"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "saved": {
          "anyOf": [
            {
              "$ref": "#/$defs/saved"
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "type": "boolean"
        },
        "directionConfirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "saved",
        "current",
        "directionConfirmed"
      ]
    },
    "getState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        }
      },
      "required": [
        "productId"
      ]
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expectedPlanRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "requestId",
        "productId",
        "expectedPlanRevision",
        "plan"
      ]
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "planRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "productId",
        "planRevision"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_INPUT",
            "INPUT_TOO_LARGE",
            "INVALID_RESPONSE",
            "NOT_FOUND",
            "REVISION_CONFLICT",
            "REQUEST_ID_CONFLICT",
            "PLAN_INCOMPLETE",
            "PLAN_STALE",
            "DIRECTION_NOT_CONFIRMED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "getStateResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "value": {
              "$ref": "#/$defs/state"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "saveResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "value": {
              "$ref": "#/$defs/saved"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "confirmResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "value": {
              "$ref": "#/$defs/saved"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    }
  }
}
