{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplatform.local/schemas/task-spec.v1.schema.json",
  "title": "AgentPlatform TaskSpec v1 (legacy)",
  "schema_version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "goal", "base_sha", "scope", "acceptance_criteria", "test_commands", "worker", "limits"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "base_sha": { "type": "string", "oneOf": [{ "pattern": "^[0-9a-f]{40}$" }, { "pattern": "^[0-9a-f]{64}$" }] },
    "context_paths": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["allowed_paths", "forbidden_paths"], "properties": {
      "allowed_paths": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/pathPattern" } },
      "forbidden_paths": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/pathPattern" } }
    } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string", "pattern": "^AC-[0-9]{2,3}$" }, "text": { "type": "string", "minLength": 1, "maxLength": 1000 } } } },
    "test_commands": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/testCommand" } },
    "worker": { "type": "object", "additionalProperties": false, "required": ["adapter", "model", "reasoning"], "properties": { "adapter": { "const": "codex" }, "model": { "type": "string", "minLength": 1, "maxLength": 100 }, "reasoning": { "enum": ["low", "medium", "high", "xhigh"] } } },
    "limits": { "type": "object", "additionalProperties": false, "required": ["max_attempts", "run_timeout_seconds", "max_changed_files", "max_diff_bytes"], "properties": { "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 }, "run_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 7200 }, "max_changed_files": { "type": "integer", "minimum": 1, "maximum": 200 }, "max_diff_bytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 } } }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)" } },
    "pathPattern": { "type": "string", "minLength": 1, "maxLength": 500, "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)" } },
    "testCommand": { "type": "object", "additionalProperties": false, "required": ["id", "program", "args", "cwd", "timeout_seconds", "required"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "program": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 100 }, "args": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } }, "cwd": { "$ref": "#/$defs/relativePath" }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }, "required": { "type": "boolean" } } }
  }
}
