{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplatform.local/schemas/agent-result.schema.json",
  "title": "AgentPlatform WorkerResult",
  "schema_version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "summary",
    "changed_files",
    "acceptance_notes",
    "risks",
    "blocker"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "status": { "type": "string", "enum": ["completed", "blocked", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "changed_files": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "acceptance_notes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "note"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^AC-[0-9]{2,3}$" },
          "note": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "blocker": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
