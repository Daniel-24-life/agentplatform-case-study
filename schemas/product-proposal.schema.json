{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplatform.local/schemas/product-proposal/1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "productId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "goalRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "goalHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "goal": {
            "$ref": "https://agentplatform.local/schemas/product-goal/1.0"
          },
          "plan": {
            "$ref": "https://agentplatform.local/schemas/product-plan/1.0#/$defs/plan"
          }
        },
        "required": [
          "id",
          "title",
          "rationale",
          "goal"
        ]
      }
    },
    "recommendedOptionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "required": [
    "schemaVersion",
    "productId",
    "goalRevision",
    "goalHash",
    "contextHash",
    "summary",
    "options",
    "recommendedOptionId",
    "questions"
  ]
}
