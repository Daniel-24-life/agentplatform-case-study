{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplatform.local/schemas/product-preview.schema.json",
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "productId",
        "taskId",
        "attemptId",
        "createdAt",
        "buildDirectory",
        "status",
        "url",
        "errorCode",
        "finishedAt",
        "logTail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "buildDirectory": {
          "enum": [
            "dist",
            "build",
            "out"
          ]
        },
        "status": {
          "enum": [
            "STARTING",
            "RUNNING",
            "STOPPING",
            "STOPPED",
            "FAILED",
            "INTERRUPTED"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80,
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/$"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "logTail": {
          "type": "string",
          "maxLength": 17000
        }
      }
    },
    "getState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "productId",
        "buildDirectory"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "buildDirectory": {
          "enum": [
            "dist",
            "build",
            "out"
          ]
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "sessionId"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "sessionId"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "getStateResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/session"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "INVALID_RESPONSE",
                    "NOT_FOUND",
                    "REQUEST_ID_CONFLICT",
                    "BUSY",
                    "NOT_READY",
                    "EVIDENCE_CHANGED",
                    "STATIC_OUTPUT_MISSING",
                    "UNSAFE_OUTPUT",
                    "OUTPUT_TOO_LARGE",
                    "START_FAILED",
                    "STOP_NOT_CONFIRMED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      ]
    },
    "startResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/session"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "INVALID_RESPONSE",
                    "NOT_FOUND",
                    "REQUEST_ID_CONFLICT",
                    "BUSY",
                    "NOT_READY",
                    "EVIDENCE_CHANGED",
                    "STATIC_OUTPUT_MISSING",
                    "UNSAFE_OUTPUT",
                    "OUTPUT_TOO_LARGE",
                    "START_FAILED",
                    "STOP_NOT_CONFIRMED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      ]
    },
    "stopResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/session"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "INVALID_RESPONSE",
                    "NOT_FOUND",
                    "REQUEST_ID_CONFLICT",
                    "BUSY",
                    "NOT_READY",
                    "EVIDENCE_CHANGED",
                    "STATIC_OUTPUT_MISSING",
                    "UNSAFE_OUTPUT",
                    "OUTPUT_TOO_LARGE",
                    "START_FAILED",
                    "STOP_NOT_CONFIRMED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      ]
    },
    "openResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/session"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "INVALID_RESPONSE",
                    "NOT_FOUND",
                    "REQUEST_ID_CONFLICT",
                    "BUSY",
                    "NOT_READY",
                    "EVIDENCE_CHANGED",
                    "STATIC_OUTPUT_MISSING",
                    "UNSAFE_OUTPUT",
                    "OUTPUT_TOO_LARGE",
                    "START_FAILED",
                    "STOP_NOT_CONFIRMED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      ]
    }
  }
}