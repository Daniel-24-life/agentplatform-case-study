{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplatform.local/schemas/product-foundation/1.0",
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "INPUT_TOO_LARGE",
            "INVALID_RESPONSE",
            "NOT_FOUND",
            "REVISION_CONFLICT",
            "REQUEST_ID_CONFLICT",
            "DIRECTION_INCOMPLETE",
            "DATA_CORRUPT",
            "INTERNAL_ERROR",
            "PRODUCT_DELETED",
            "PRODUCT_BUSY"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repositoryId": {
          "type": "null"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "goalRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confirmedGoalRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "deletedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "repositoryId",
        "revision",
        "goalRevision",
        "confirmedGoalRevision",
        "createdAt",
        "updatedAt"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "goal": {
          "$ref": "https://agentplatform.local/schemas/product-goal/1.0"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "revision",
        "hash",
        "goal",
        "createdAt"
      ]
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "#/$defs/summary"
        },
        "goal": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "product",
        "goal"
      ]
    },
    "historyItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "hash",
        "createdAt",
        "confirmedAt"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "enum": [
            "PRODUCT_CREATED",
            "GOAL_REVISED",
            "DIRECTION_CONFIRMED",
            "REPOSITORY_BOUND",
            "PRODUCT_TRASHED",
            "PRODUCT_RESTORED"
          ]
        },
        "goalRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workspaceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "productId",
        "sequence",
        "type",
        "goalRevision",
        "workspaceRevision",
        "createdAt"
      ]
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "initialRequest": {
          "type": "string",
          "maxLength": 65536,
          "minLength": 1
        }
      },
      "required": [
        "requestId",
        "name",
        "initialRequest"
      ]
    },
    "reviseGoal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "goal": {
          "$ref": "https://agentplatform.local/schemas/product-goal/1.0"
        }
      },
      "required": [
        "requestId",
        "productId",
        "expectedRevision",
        "goal"
      ]
    },
    "confirmDirection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "goalRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "productId",
        "expectedRevision",
        "goalRevision"
      ]
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "afterId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "trash": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "productId",
        "expectedRevision"
      ]
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "productId",
        "expectedRevision"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "scope": {
          "const": "PRODUCT_HISTORY"
        },
        "taskCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passedTaskCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "technicalCompletionRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "directionConfirmations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "planConfirmations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "specApprovals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "escalationApprovals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keyConfirmationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repairAttemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedAttemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "agentRunCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationAvailableRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recordedDurationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usageAvailableRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usageCoverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "productId",
        "scope",
        "taskCount",
        "passedTaskCount",
        "technicalCompletionRate",
        "directionConfirmations",
        "planConfirmations",
        "specApprovals",
        "escalationApprovals",
        "keyConfirmationCount",
        "attemptCount",
        "repairAttemptCount",
        "failedAttemptCount",
        "runCount",
        "agentRunCount",
        "durationAvailableRuns",
        "recordedDurationMs",
        "usageAvailableRuns",
        "usageCoverage",
        "inputTokens",
        "outputTokens",
        "totalTokens"
      ]
    },
    "getMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        }
      },
      "required": [
        "productId"
      ]
    },
    "getOverview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        }
      },
      "required": [
        "productId"
      ]
    },
    "getGoal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "productId",
        "revision"
      ]
    },
    "getGoalHistory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "afterRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "productId"
      ]
    },
    "readEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "afterSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "productId"
      ]
    },
    "createResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/overview"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "reviseGoalResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/overview"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "confirmDirectionResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/overview"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "trashResponse": {
      "$ref": "#/$defs/confirmDirectionResponse"
    },
    "restoreResponse": {
      "$ref": "#/$defs/confirmDirectionResponse"
    },
    "getMetricsResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/metrics"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "getOverviewResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/overview"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "getGoalResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/snapshot"
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "listResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/summary"
                  },
                  "maxItems": 100
                },
                "nextCursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,100}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "nextCursor"
              ]
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "getGoalHistoryResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/historyItem"
                  },
                  "maxItems": 100
                },
                "nextCursor": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "nextCursor"
              ]
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "readEventsResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/event"
                  },
                  "maxItems": 256
                },
                "nextCursor": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "nextCursor"
              ]
            }
          },
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    }
  }
}
